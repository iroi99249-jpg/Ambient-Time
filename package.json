{
  "name": "ambient-time",
  "version": "0.1.0",
  "private": true,
  "description": "日本語対応のWindows向けアンビエント・スクリーンアプリ",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "jp.ambienttime.app",
    "productName": "Ambient Time",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
